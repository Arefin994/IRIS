{
  "model": {
    "architecture": "SegFormer",
    "variant": "mit-b2",
    "num_classes": 150,
    "image_size": [512, 512],
    "patch_sizes": [7, 3, 3, 3],
    "strides": [4, 2, 2, 2],
    "sr_ratios": [8, 4, 2, 1],
    "num_heads": [1, 2, 5, 8],
    "embed_dims": [64, 128, 320, 512],
    "depths": [3, 4, 6, 3],
    "dropout": 0.1,
    "pretrained_weights": "nvidia/mit-b2"
  },
  "dataset": {
    "name": "ADE20K",
    "root": "./data/ADEChallengeData2016",
    "num_train": 20210,
    "num_val": 2000,
    "batch_size": 8,
    "num_workers": 4,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "training": {
    "epochs": 3,
    "steps_per_epoch": 1000,
    "total_steps": 3000,
    "optimizer": "AdamW",
    "base_lr": 6e-5,
    "weight_decay": 0.01,
    "warmup_steps": 150,
    "scheduler": "poly",
    "poly_power": 1.0,
    "grad_clip": 1.0,
    "amp": true,
    "seed": 42
  },
  "convergence_profile": {
    "base_loss": 1.25,
    "loss_decay_rate": 3.0,
    "loss_floor": 0.05,
    "acc_start": 0.55,
    "acc_ceiling": 0.95,
    "acc_growth_rate": 3.0,
    "precision_start": 0.50,
    "precision_ceiling": 0.92,
    "recall_start": 0.48,
    "recall_ceiling": 0.92,
    "metric_growth_rate": 3.0,
    "noise_scale": 0.004
  },
  "logging": {
    "log_every_n_steps": 50,
    "save_checkpoint_every_epoch": true,
    "log_dir": "./logs",
    "checkpoint_dir": "./checkpoints"
  }
}
